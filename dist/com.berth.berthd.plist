<?xml version="1.0" encoding="UTF-8"?>
<!--
  berthd — launchd LaunchAgent (macOS, per-user). Setup steps: dist/README.md.
  Replace /Users/CHANGEME below with your home directory.

  KeepAlive/SuccessfulExit=false restarts berthd only after a crash (non-zero exit), not after
  `berth kill-server` (exit 0) — the same as systemd's Restart=on-failure.
  macOS has no XDG_RUNTIME_DIR, so the socket is ~/.berth/berthd.sock.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.berth.berthd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/CHANGEME/.local/bin/berthd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/berthd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/berthd.log</string>
</dict>
</plist>
