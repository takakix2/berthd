# berthd — systemd user service (a per-user daemon that owns your shells).
# Setup steps: dist/README.md. Run `loginctl enable-linger "$USER"` too, or berthd stops
# when your last login session ends.

[Unit]
Description=berthd — persistent shell session daemon (owns PTYs)
Documentation=https://github.com/takakix2/berthd
After=default.target

[Service]
Type=simple
# %h is your home directory. If berthd lives elsewhere, write its absolute path (systemd does not use PATH).
ExecStart=%h/.local/bin/berthd
# Restart only after a crash. `berth kill-server` exits 0, so it is not restarted.
Restart=on-failure
RestartSec=2
# The socket is $XDG_RUNTIME_DIR/berthd.sock (/run/user/UID/, set by systemd for user services).

[Install]
WantedBy=default.target
